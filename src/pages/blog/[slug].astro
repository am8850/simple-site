---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { posts, type BlogPost } from "../../data/posts";

export function getStaticPaths() {
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props as { post: BlogPost };
---

<BaseLayout title={post.title} description={post.excerpt}>
    <article class="mx-auto w-full max-w-3xl px-6 py-16 lg:px-8 lg:py-20">
        <p
            class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-300"
        >
            {post.category}
        </p>
        <h1
            class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl"
        >
            {post.title}
        </h1>
        <div
            class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-400"
        >
            <span>{post.publishDate}</span>
            <span class="text-slate-600">•</span>
            <span>{post.readingTime} min read</span>
        </div>
        <p class="mt-8 text-xl leading-8 text-slate-300">{post.excerpt}</p>

        <div class="mt-10 space-y-6 text-lg leading-8 text-slate-300">
            {post.content.map((paragraph: string) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-12 rounded-3xl border border-white/10 bg-white/5 p-6">
            <p class="text-sm font-semibold text-sky-300">From the notebook</p>
            <p class="mt-3 text-base leading-7 text-slate-300">
                Each post here is part essay, part field note: what I’m learning
                about agentic development, what I’m skeptical of, and which
                shifts in the AI landscape are worth paying attention to.
            </p>
            <a
                class="mt-5 inline-flex items-center text-sm font-semibold text-sky-300 transition hover:text-sky-200"
                href="/blog"
            >
                Back to all posts →
            </a>
        </div>
    </article>
</BaseLayout>
