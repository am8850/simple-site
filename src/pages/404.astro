---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Page not found"
    description="The page you were looking for could not be found."
>
    <section
        class="mx-auto flex min-h-[60vh] w-full max-w-3xl flex-col items-start justify-center px-6 py-16 lg:px-8 lg:py-20"
    >
        <p
            class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-300"
        >
            404
        </p>
        <h1
            class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl"
        >
            That page isn’t here.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            The link may be outdated, or the article may have moved. You can
            head back to the homepage or browse the latest posts from the
            archive.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
            <a
                class="inline-flex items-center justify-center rounded-full bg-sky-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-300"
                href="/"
            >
                Go home
            </a>
            <a
                class="inline-flex items-center justify-center rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:border-sky-300/50 hover:bg-white/5"
                href="/blog"
            >
                Browse the blog
            </a>
        </div>
    </section>
</BaseLayout>
