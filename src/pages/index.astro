---
import BaseLayout from "../layouts/BaseLayout.astro";
import { posts, type BlogPost } from "../data/posts";

const featuredPost: BlogPost = posts[0];
const recentPosts: BlogPost[] = posts.slice(1);
---

<BaseLayout
    title="Agentic Notes"
    description="A personal blog about agentic development, AI workflows, and news."
>
    <section
        class="mx-auto flex w-full max-w-6xl flex-col gap-16 px-6 py-16 lg:px-8 lg:py-20"
    >
        <section class="grid gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
            <div>
                <p
                    class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-300"
                >
                    Personal Blog
                </p>
                <h1
                    class="mt-4 max-w-3xl text-5xl font-semibold tracking-tight text-white sm:text-6xl"
                >
                    Notes on agentic development, AI tooling, and the news worth
                    watching.
                </h1>
                <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                    I write about building with AI agents, designing calmer
                    developer workflows, and tracking the product and research
                    updates that actually change how we work.
                </p>

                <div class="mt-8 flex flex-wrap gap-4">
                    <a
                        class="inline-flex items-center justify-center rounded-full bg-sky-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-300"
                        href="/blog"
                    >
                        Read the latest posts
                    </a>
                    <a
                        class="inline-flex items-center justify-center rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:border-sky-300/50 hover:bg-white/5"
                        href="/blog/weekly-agent-news-roundup"
                    >
                        Read the weekly roundup
                    </a>
                </div>
            </div>

            <aside
                class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl shadow-slate-950/40 backdrop-blur"
            >
                <p class="text-sm font-medium text-sky-300">Featured essay</p>
                <h2 class="mt-3 text-2xl font-semibold text-white">
                    {featuredPost.title}
                </h2>
                <p class="mt-3 text-sm text-slate-400">
                    {featuredPost.publishDate} · {featuredPost.readingTime} min read
                </p>
                <p class="mt-4 text-base leading-7 text-slate-300">
                    {featuredPost.excerpt}
                </p>
                <a
                    class="mt-6 inline-flex items-center text-sm font-semibold text-sky-300 transition hover:text-sky-200"
                    href={`/blog/${featuredPost.slug}`}
                >
                    Continue reading →
                </a>
            </aside>
        </section>

        <section class="grid gap-6 lg:grid-cols-3">
            <article
                class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur"
            >
                <p class="text-sm font-medium text-sky-300">
                    Agentic workflows
                </p>
                <h2 class="mt-3 text-xl font-semibold text-white">
                    Working with agents without losing the plot
                </h2>
                <p class="mt-3 text-sm leading-7 text-slate-300">
                    I’m interested in the habits, prompts, and review loops that
                    make AI agents genuinely useful for software work.
                </p>
            </article>
            <article
                class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur"
            >
                <p class="text-sm font-medium text-sky-300">
                    News and analysis
                </p>
                <h2 class="mt-3 text-xl font-semibold text-white">
                    Weekly updates filtered for builders
                </h2>
                <p class="mt-3 text-sm leading-7 text-slate-300">
                    I track launches, research, and product shifts across the AI
                    ecosystem with a bias toward practical implications.
                </p>
            </article>
            <article
                class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur"
            >
                <p class="text-sm font-medium text-sky-300">
                    Personal perspective
                </p>
                <h2 class="mt-3 text-xl font-semibold text-white">
                    Essays from the editor’s chair
                </h2>
                <p class="mt-3 text-sm leading-7 text-slate-300">
                    This site is framed like a personal publication:
                    opinionated, curious, and focused on what changes daily
                    practice.
                </p>
            </article>
        </section>

        <section class="space-y-6">
            <div class="flex items-end justify-between gap-4">
                <div>
                    <p
                        class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-300"
                    >
                        Recent posts
                    </p>
                    <h2 class="mt-2 text-3xl font-semibold text-white">
                        Latest writing
                    </h2>
                </div>
                <a
                    class="text-sm font-semibold text-sky-300 transition hover:text-sky-200"
                    href="/blog"
                >
                    View all posts →
                </a>
            </div>

            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                {
                    recentPosts.map((post: BlogPost) => (
                        <article class="rounded-3xl border border-white/10 bg-slate-900/80 p-6 transition hover:-translate-y-1 hover:border-sky-300/30 hover:bg-slate-900">
                            <p class="text-sm text-slate-400">
                                {post.publishDate} · {post.category}
                            </p>
                            <h3 class="mt-3 text-xl font-semibold text-white">
                                {post.title}
                            </h3>
                            <p class="mt-4 text-sm leading-7 text-slate-300">
                                {post.excerpt}
                            </p>
                            <a
                                class="mt-6 inline-flex items-center text-sm font-semibold text-sky-300 transition hover:text-sky-200"
                                href={`/blog/${post.slug}`}
                            >
                                Read article →
                            </a>
                        </article>
                    ))
                }
            </div>
        </section>

        <section
            class="rounded-3xl border border-sky-300/20 bg-sky-400/10 p-8 lg:p-10"
        >
            <div class="max-w-3xl">
                <p
                    class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-300"
                >
                    About this blog
                </p>
                <h2 class="mt-3 text-3xl font-semibold text-white">
                    A personal notebook for the age of software agents.
                </h2>
                <p class="mt-4 text-base leading-8 text-slate-300">
                    Agentic development is moving fast, and most of the
                    interesting lessons are hiding in workflows, interfaces, and
                    tradeoffs rather than headlines alone. This blog is where I
                    collect those lessons.
                </p>
            </div>
        </section>
    </section>
</BaseLayout>
